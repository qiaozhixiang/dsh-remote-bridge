{
  "manifest_version": 2,
  "id": "github.qiaozhixiang.dsh-remote-bridge",
  "name": "DSH 远程桥接",
  "version": "1.6.4",
  "description": "把本机 DSH（DeepSeek Shell）的会话、模型与实时输出接到 MaiBot：QQ 命令远程对话、公网隧道、内网通道、插件批量开关与 WebUI 控制台",
  "author": {
    "name": "qiaozhixiang",
    "url": "https://github.com/qiaozhixiang"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/qiaozhixiang/dsh-remote-bridge",
    "homepage": "https://github.com/qiaozhixiang/dsh-remote-bridge",
    "documentation": "https://github.com/qiaozhixiang/dsh-remote-bridge/blob/main/README.md",
    "issues": "https://github.com/qiaozhixiang/dsh-remote-bridge/issues"
  },
  "changelog": "CHANGELOG.md",
  "plugin_type": "integration",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.text",
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "puzzle",
      "background": "#0F172A"
    }
  }
}
