{
  "manifest_version": 2,
  "id": "github.qiaozhixiang.office-toolkit",
  "version": "1.2.4",
  "name": "办公文件工具箱",
  "description": "用自然语言或 QQ 指令操作本机办公文件：读写 Word/Excel/PPT/PDF/ZIP，聊天文件自动入库，批量增删改查、差异对比、成绩核查、奖学金评定、表格格式化，AI 指令自动编排多步操作。",
  "author": {
    "name": "qiaozhixiang",
    "url": "https://github.com/qiaozhixiang"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/qiaozhixiang/office-toolkit-dist",
    "homepage": "https://github.com/qiaozhixiang/office-toolkit-dist",
    "documentation": "https://github.com/qiaozhixiang/office-toolkit-dist/blob/main/README.md",
    "issues": "https://github.com/qiaozhixiang/office-toolkit-dist/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.3.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "capabilities": [
    "send.text",
    "send.custom",
    "api.call",
    "llm.generate",
    "message.get_recent",
    "message.get_by_id"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "plugin_type": "extension",
  "display": {
    "icon": {
      "type": "local",
      "value": "assets/icon.svg",
      "fallback": "file-text",
      "background": "#eef2ff"
    }
  },
  "changelog": "CHANGELOG.md"
}
